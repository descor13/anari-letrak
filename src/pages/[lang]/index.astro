---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import AlbumList from '../../components/AlbumList.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'eu' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params;

const copy = {
  eu: {
    section: 'Letrak',
    note: 'Letrak argitaratzeko, testu bakoitzaren baimena edo iturri baimendua gehitu beharko da.',
    footer: 'Instagram · Bandcamp · YouTube'
  },
  es: {
    section: 'Letras',
    note: 'Para publicar letras completas, conviene incorporar cada texto con permiso o desde una fuente autorizada.',
    footer: 'Instagram · Bandcamp · YouTube'
  }
};
---

<BaseLayout title="Anari Letrak">
  <div class="home-dark">
    <Header currentLang={lang} />

    <main class="site-shell">
      <Hero lang={lang} />

      <section>
        <h2 class="section-title">{copy[lang].section}</h2>
        <AlbumList lang={lang} />
      </section>

      <p class="section-title">{copy[lang].note}</p>

      <footer class="footer-links">
  <a href="https://instagram.com/anari_alberdi" target="_blank">
    Instagram
  </a>

  <a href="https://anari.bandcamp.com/" target="_blank">
    Bandcamp
  </a>

  <a href="https://www.facebook.com/anarirena" target="_blank">
    Facebook
  </a>
</footer>
    </main>
  </div>
</BaseLayout>




