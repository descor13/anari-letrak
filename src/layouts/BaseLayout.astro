---
import '../styles/global.css';
const { title = 'Anari Letrak', description = 'Anari kantuen letrak / letras de canciones de Anari' } = Astro.props;
---
<!doctype html>
<html lang="eu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-sans text-zinc-950 antialiased">
    <slot />
  </body>
</html>
